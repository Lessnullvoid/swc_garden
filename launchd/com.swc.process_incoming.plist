<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  com.swc.process_incoming.plist
  Runs process_incoming.py every 15 minutes to calibrate and extract
  features from Pi camera images.

  Install:
    cp launchd/com.swc.process_incoming.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.swc.process_incoming.plist

  Unload:
    launchctl unload ~/Library/LaunchAgents/com.swc.process_incoming.plist
-->
<dict>
    <key>Label</key>
    <string>com.swc.process_incoming</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/microhm/Desktop/01_Proyectos/SWC/software/venv/bin/python</string>
        <string>process_incoming.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/microhm/Desktop/01_Proyectos/SWC/software</string>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/microhm/Desktop/01_Proyectos/SWC/software/daily_datasets/process_incoming_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/microhm/Desktop/01_Proyectos/SWC/software/daily_datasets/process_incoming_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
